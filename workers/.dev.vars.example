# Copy sang .dev.vars (gitignored) để chạy wrangler dev local
# .dev.vars được wrangler load tự động khi chạy `npx wrangler dev`
# Điền giá trị thật từ Cloudflare dashboard / Supabase dashboard.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SERVICE_TOKEN=generate-a-long-random-secret (vd: openssl rand -hex 32)
