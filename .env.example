# URL + anon key (public, expose được cho client)
NEXT_PUBLIC_SUPABASE_URL=https://ysehlghdwodsovaxxwpx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlzZWhsZ2hkd29kc292YXh4d3B4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODcwNTc1MDksImV4cCI6MjEwMjYzMzUwOX0.gNvaSmbGeAELt0dkOms4q2wnORDvKxEE4jt6tSgDIZI

# Service role key (SECRET — chỉ dùng server-side, KHÔNG để lộ ra client)
# Lấy ở Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# imgBB API key cho upload ảnh minh họa (server-side only)
# Lấy ở https://api.imgbb.com/ → KHÔNG commit key thật. Set trên Vercel env IMGBB_API_KEY.
IMGBB_API_KEY=xxxx_thay_key_that_o_vercel_env
