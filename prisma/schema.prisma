// SoNovel — Prisma schema mirroring SPEC §5 (Supabase tables)
// SQLite provider. text[] columns stored as String (JSON-encoded).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---- Auth: profiles + users (mirror profiles + auth.users) ----
model Profile {
  id        String   @id // = auth user id
  email     String   @unique
  role      String   @default("user") // 'user' | 'admin'
  passwordHash String
  createdAt DateTime @default(now())

  progress     Progress[]
  favorites    Favorite[]
  bookmarks    Bookmark[]
  history      History[]
  userSettings UserSettings?
}

// ---- series (bộ truyện) ----
model Series {
  id          String   @id @default(cuid())
  title       String
  author      String   @default("")
  description String   @default("")
  coverUrl    String   @default("")
  // status: 'draft' | 'published' | 'completed' | 'hidden'
  status      String   @default("published")
  // genres / tags stored as JSON array string (SQLite has no native array)
  genres      String   @default("[]")
  tags        String   @default("[]")
  wordCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chapters  Chapter[]
  progress  Progress[]
  favorites Favorite[]
  history   History[]

  @@index([status])
  @@index([updatedAt])
}

// ---- chapters — ONLY 2 statuses: draft | published (§5.2, §10.5) ----
model Chapter {
  id          String    @id @default(cuid())
  seriesId    String
  orderNo     Int
  title       String
  content     String    @default("")
  // status: 'draft' | 'published'  ← CHỈ 2 trạng thái
  status      String    @default("published")
  publishedAt DateTime?
  wordCount   Int       @default(0)
  createdAt   DateTime  @default(now())

  series         Series      @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  readProgress   Progress[]  @relation("ReadChapter")
  listenProgress Progress[]  @relation("ListenChapter")

  @@unique([seriesId, orderNo])
  @@index([seriesId, status])
}

// ---- progress — dual track READ + LISTEN ----
model Progress {
  id               String    @id @default(cuid())
  userId           String
  seriesId         String
  // READ track
  readChapterId    String?
  readCharIndex    Int       @default(0)
  readPercent      Float     @default(0)
  lastReadAt       DateTime?
  // LISTEN track
  listenChapterId  String?
  listenCharIndex  Int       @default(0)
  audioSec         Float     @default(0)
  playbackSpeed    Float     @default(1.0)
  lastListenedAt   DateTime?
  updatedAt        DateTime  @updatedAt

  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  series Series  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  readChapter    Chapter? @relation("ReadChapter", fields: [readChapterId], references: [id], onDelete: SetNull)
  listenChapter  Chapter? @relation("ListenChapter", fields: [listenChapterId], references: [id], onDelete: SetNull)

  @@unique([userId, seriesId])
  @@index([userId])
}

// ---- favorites (user_id + series_id PK) ----
model Favorite {
  userId    String
  seriesId  String
  createdAt DateTime @default(now())

  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  series Series  @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([userId, seriesId])
}

// ---- bookmarks ----
model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  seriesId  String
  chapterId String
  charIndex Int      @default(0)
  note      String   @default("")
  createdAt DateTime @default(now())

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, seriesId])
}

// ---- history (user_id + series_id PK) ----
model History {
  userId       String
  seriesId     String
  openedCount  Int      @default(1)
  lastOpenedAt DateTime @default(now())

  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  series Series  @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([userId, seriesId])
}

// ---- user_settings ----
model UserSettings {
  userId        String  @id
  // theme: 'light' | 'dark' | 'sepia' | 'amoled'
  theme         String  @default("light")
  playbackSpeed Float   @default(1.0)
  fontSize      Int     @default(18)
  fontFamily    String  @default("system")
  lineHeight    Float   @default(1.7)
  autoplayNext  Boolean @default(true)
  updatedAt     DateTime @updatedAt

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---- chapter_audio (dự phòng, chưa dùng) ----
model ChapterAudio {
  chapterId  String  @id
  audioUrl   String  @default("")
  durationSec Float  @default(0)
  createdAt  DateTime @default(now())
}

// ---- tags master ----
model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}
